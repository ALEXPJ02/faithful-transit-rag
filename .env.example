# Copy to .env and fill in. .env is gitignored — never commit real keys.
# See docs/05-setup-checklist.md for where each key comes from.

# --- Generation + evaluation judge (Anthropic Console) ---
ANTHROPIC_API_KEY=
# Confirm the exact model IDs against platform.claude.com/docs before a long eval run.
ANTHROPIC_GENERATION_MODEL=claude-sonnet-5
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5

# --- Embeddings (Voyage AI dashboard; 200M free tokens) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-lite

# --- Transport for NSW Open Data Hub (opendata.transport.nsw.gov.au) ---
# One key, scoped to the Realtime Trip Update v2 + Service Alerts products.
TFNSW_API_KEY=
# v2 Sydney Trains trip updates — confirmed from the product's OpenAPI console.
# The version is a path prefix (/v2/gtfs/realtime), not a suffix.
TFNSW_TRIP_UPDATE_URL=https://api.transport.nsw.gov.au/v2/gtfs/realtime/sydneytrains
# Service Alerts is a separate product on the same /v2/ prefix. It also serves
# /all (every operator) if the agent's live tools ever want the wider view.
TFNSW_ALERTS_URL=https://api.transport.nsw.gov.au/v2/gtfs/alerts/sydneytrains

# --- Local paths (defaults are fine) ---
CHROMA_PERSIST_DIR=.chroma
COLLECTION_DB_PATH=data/delay_observations.db
COLLECTION_SNAPSHOT_DIR=data/observations
COLLECTION_ROUTES_LOOKUP=data/routes_lookup.csv

# --- Delay collection ---
# sqlite: a long-running collector that keeps its own state (upserts, so the
#         table is always the latest value per stop event).
# csv:    a stateless scheduled run that can only append files to a repo.
COLLECTION_SINK=sqlite
POLLER_INTERVAL_SECONDS=120
POLLER_ROUTES=T1,T4
# Upcoming stops kept per trip, per poll. The feed republishes ~20 of them,
# nearly all distant guesses; keeping the imminent few is the difference
# between ~1M rows a day and ~25k. Raise it if you poll less often than
# every few minutes. 0 keeps everything.
POLLER_MAX_UPCOMING_STOPS=3
